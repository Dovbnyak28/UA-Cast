<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- SSDP discovery (DLNA): the multicast lock SsdpDiscovery takes for the duration of an
         M-SEARCH needs this. Normal Wi-Fi hardware filters multicast traffic out while the device
         is idle, so without the lock the renderers' replies simply never reach the socket. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- This app is distributed by sideload, not through a store, so it updates itself: it
         downloads the APK attached to a GitHub release and hands it to the system package
         installer (see data/update/ApkInstaller). Without this the installer refuses the session
         outright. From API 26 the user must additionally allow "install unknown apps" for this
         app; the Settings row asks for that when it is missing. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Normal protection, so it is granted at install time. It only ever lets a session *ask* to
         skip the confirmation dialog, and the system grants that under its own conditions - which
         include this app being the installer of record for the package it is updating, something
         the first update installed this way cannot be. So the dialog is expected at least once and
         UpdateInstallReceiver treats being asked for it as an ordinary outcome. -->
    <uses-permission
        android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- CastProxyService is a foreground service that posts a notification and holds a partial
         wake lock plus a Wi-Fi lock for the whole cast (see CastWakeLocks). From API 33 that
         notification is silently dropped without this permission, which would leave the user with
         an invisible service they cannot see running or stop from outside the app. Requested at
         runtime the first time a cast session actually starts - see MainActivity. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.wifi"
        android:required="false" />

    <application
        android:name=".UaCastPlayerApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:banner="@drawable/tv_banner"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.UaCastPlayer"
        android:supportsRtl="true"
        tools:targetApi="33"
        android:enableOnBackInvokedCallback="true">

        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.uacastplayer.cast.CastOptionsProvider" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode"
            android:theme="@style/Theme.UaCastPlayer.Splash"
            android:supportsPictureInPicture="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- LEANBACK_LAUNCHER deliberately omitted - the UI has no D-pad/focus navigation
                     yet, so the app is unusable on a real TV launcher. See docs/TV_SUPPORT.md for
                     what's needed before re-adding it. The leanback uses-feature/banner below are
                     left in place since they're harmless and save re-plumbing them later. -->
            </intent-filter>
        </activity>

        <service
            android:name="com.google.android.gms.cast.framework.ReconnectionService"
            android:exported="false" />

        <service
            android:name=".cast.CastProxyService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- androidx.media3.session.MediaButtonReceiver is deliberately NOT declared here.
             It exists to wake a MediaSessionService, and its handleIntentAndMaybeStartTheService
             throws IllegalStateException("Could not find any Service that handles any of the
             actions ...") when there is none. This app has no MediaSessionService on purpose - see
             PlayerViewModel, live TV is not expected to keep playing after the player closes.

             Declaring it was therefore a crash waiting on a headset button: MediaSessionLegacyStub
             picks a declared receiver as the media-button target on API 31+, so the first press
             from a headset, watch or car would have gone straight into that throw. Below API 31 it
             was merely inert.

             Nothing is lost by leaving it out. When no receiver and no service are declared,
             MediaSessionLegacyStub registers its own in-process receiver for ACTION_MEDIA_BUTTON,
             which is exactly the "works while the app is alive" behaviour this app wants. -->

        <!-- Locale storage is handled by our own AppPreferences (see core.i18n.LocalizedContext),
             not AppCompat's auto-store, so this stays disabled per the per-app-language docs. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false" />

        <!-- Where the system reports what became of an update install. Not exported: the only
             sender is this app's own PendingIntent, handed to the package installer, and the
             system delivers it back to the component the intent names regardless. Exporting it
             would let any app on the device fake an install result. -->
        <receiver
            android:name=".data.update.UpdateInstallReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.uacastplayer.action.INSTALL_STATUS" />
            </intent-filter>
        </receiver>

        <!-- Lets a diagnostics report be attached to an email as a file. Not exported: the grant
             travels with the intent (FLAG_GRANT_READ_URI_PERMISSION) to the one app the user picks,
             for the one file named in it, and lapses on its own. See DiagnosticsArchive, and
             res/xml/diagnostics_paths.xml for how little of the app it can reach. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.diagnostics"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/diagnostics_paths" />
        </provider>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup"
                tools:node="merge" />
        </provider>
    </application>
</manifest>
