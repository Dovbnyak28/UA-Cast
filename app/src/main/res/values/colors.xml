<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Only the handful the *platform* needs: this file is not the app's palette, ui/theme/Color.kt
         is. Anything Compose draws belongs there; an XML color is only justified when something
         outside Compose has to read it (a theme attribute, a drawable). The surface/primary/cyan/
         border/on-surface/error entries that used to sit here were a stale mirror of an older
         palette that nothing referenced. -->
    <color name="uacast_background">#070A12</color>

    <!-- Mirrors ui/theme/Color.kt's LabelPrimary/Azure so the platform MediaRouteButton (which
         can only be tinted via theme attributes, not Compose) matches the rest of the design
         system instead of AppCompat's default dark-on-light colorControlNormal. -->
    <color name="uacast_label_primary">#F5F5F7</color>
    <color name="uacast_azure">#0A84FF</color>
</resources>
