<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.UaCastPlayer" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/uacast_background</item>
        <item name="android:navigationBarColor">@color/uacast_background</item>
        <item name="android:windowBackground">@color/uacast_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
    </style>

    <style name="Theme.UaCastPlayer.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/uacast_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.UaCastPlayer</item>
    </style>

</resources>
