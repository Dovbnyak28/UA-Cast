<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Always-dark AppCompat base (not DayNight): this app has no light variant - every color is
         hardcoded dark already (see below), and there's no values-night/ resource set. DayNight
         mattered for one specific bug: MediaRouteButton (see CastButton.kt) picks its icon
         drawable from AppCompat's light/dark theme resolution, not from colorControlNormal alone -
         with DayNight, a phone in system light mode got the icon variant meant for light
         backgrounds, rendering nearly invisible on this app's always-dark UI. -->
    <!-- Deliberately no android:statusBarColor/navigationBarColor: both are deprecated and are
         no-ops from targetSdk 35, and MainActivity's enableEdgeToEdge() sets the bars transparent
         on every API level anyway (see its own comment). Leaving them here would have read as the
         thing controlling the bars while controlling nothing. -->
    <style name="Theme.UaCastPlayer" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/uacast_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
    </style>

    <style name="Theme.UaCastPlayer.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/uacast_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.UaCastPlayer</item>
    </style>

    <!-- AppCompat's mediaRouteButtonStyle tints the icon from colorControlNormal - explicit here as
         defense-in-depth alongside the base theme's now-forced-dark resolution above. Only
         override the tint attributes; CastButton wraps its context with this style instead of
         changing the app theme, so it doesn't affect anything else. -->
    <style name="Theme.UaCastPlayer.CastButton" parent="Theme.UaCastPlayer">
        <item name="colorControlNormal">@color/uacast_label_primary</item>
        <item name="colorControlActivated">@color/uacast_azure</item>
    </style>

</resources>
