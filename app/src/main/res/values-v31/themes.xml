<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Plain Theme.SplashScreen, not .IconBackground: the wordmark artwork (splash_logo) is a
         wide rectangle, and IconBackground's circular/squircle chip behind the icon would clip
         its sides - see themes.xml's base style for the non-v31 fallback, kept in sync. -->
    <style name="Theme.UaCastPlayer.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/uacast_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.UaCastPlayer</item>
    </style>

</resources>
