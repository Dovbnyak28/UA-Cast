<?xml version="1.0" encoding="utf-8"?>
<!--
  Cinema theme's serif display font (regular weight), fetched from Google's Downloadable Fonts
  provider rather than bundled as a binary - see docs/DESIGN_SYSTEM.md "Themes" for why. Requires
  Google Play Services; falls back to the platform default font when unavailable (e.g. some
  Android TV boxes without GMS) - verify on-device, this can't be checked from a plain build.
-->
<font-family xmlns:app="http://schemas.android.com/apk/res-auto"
    app:fontProviderAuthority="com.google.android.gms.fonts"
    app:fontProviderPackage="com.google.android.gms"
    app:fontProviderQuery="name=Playfair Display&amp;weight=400"
    app:fontProviderCerts="@array/com_google_android_gms_fonts_certs" />
