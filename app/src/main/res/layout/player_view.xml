<?xml version="1.0" encoding="utf-8"?>
<!-- Inflated by ui/player/PlayerScreen.kt's VideoSurface instead of constructing PlayerView(ctx)
     directly to select the video-only content and surface_type=texture_view - no programmatic setter for
     it, only this XML attribute. SurfaceView (the default) is a separate hardware-composited
     layer that SurfaceFlinger punches a hole for; Compose's own click-consuming Play/Pause button
     drawn on top of it in the same Box was found to never receive the tap (it fell through to the
     Box's own "toggle controls" click instead, field-confirmed via a tap that always logged the
     wrong handler) - a known category of Compose+SurfaceView touch-dispatch interop issue.
     TextureView is a normal View that participates in the ordinary view/touch hierarchy, at the
     cost of composition within the app window. Keep this path until surface/overlay interaction is
     independently verified; removing the unused native controller does not change surface ownership. -->
<androidx.media3.ui.PlayerView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/player_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:player_layout_id="@layout/player_surface_content"
    app:surface_type="texture_view"
    app:use_controller="false" />
