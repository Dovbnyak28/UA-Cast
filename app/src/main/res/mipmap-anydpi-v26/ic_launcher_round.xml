<?xml version="1.0" encoding="utf-8"?>
<!-- Identical to ic_launcher.xml on purpose: an adaptive icon is already shape-agnostic, so the
     round variant only exists because launchers that ask for it expect the resource to be there.
     See ic_launcher.xml for what each layer is. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
