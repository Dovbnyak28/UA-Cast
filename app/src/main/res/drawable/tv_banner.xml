<?xml version="1.0" encoding="utf-8"?>
<!-- A pre-rasterized 640x360 banner avoids legacy launchers' low-quality vector conversion.
     nodpi prevents resource decoding from first reducing this source to the TV's density.
     Filter the final launcher scale, including focus zoom. Editable source: tv_banner_artwork.xml. -->
<bitmap xmlns:android="http://schemas.android.com/apk/res/android"
    android:src="@drawable/tv_banner_hd"
    android:filter="true"
    android:dither="true"
    android:gravity="fill" />
