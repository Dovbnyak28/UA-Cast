<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Google Play builds do not sideload APKs. Keep the updater available only in the
         sideload release variant, where the user explicitly opted into this distribution path. -->
    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION"
        tools:node="remove" />
    <application>
        <receiver
            android:name=".data.update.UpdateInstallReceiver"
            tools:node="remove" />
    </application>
</manifest>
